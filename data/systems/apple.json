[{"id":"system1","name":"System","version":"1.0","vendor":"Apple","vendorId":"apple","year":1984,"hall":"apple","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/system1.jpg","skin":{"chrome":"macclassic","bar":"top","menu":"apple","accent":"#ffffff","font":"Chicago,'Microsoft YaHei',sans-serif"},"note":"第一台麦金塔的系统，一位色黑白屏、单软驱、垃圾桶。图形界面从实验室走进了普通人的桌子。"},{"id":"system6","name":"System","version":"6","vendor":"Apple","vendorId":"apple","year":1988,"hall":"apple","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/system6.jpg","skin":{"chrome":"macclassic","bar":"top","menu":"apple","accent":"#ffffff","font":"Geneva,'Microsoft YaHei',sans-serif"},"note":"彩色 QuickDraw、MultiFinder 多任务。这一代把 Mac 从玩具变成了能干活的机器。"},{"id":"classicmac","name":"Mac OS","version":"7.5","vendor":"Apple","vendorId":"apple","year":1994,"hall":"apple","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/classicmac.jpg","skin":{"chrome":"macclassic","bar":"top","menu":"apple","accent":"#ffffff","font":"Geneva,Chicago,'Microsoft YaHei',sans-serif"},"note":"黑白一位色、菜单栏永远在顶上、垃圾桶固定在右下角。图形界面第一次变成普通人能用的东西。"},{"id":"macos8","name":"Mac OS","version":"8.0","vendor":"Apple","vendorId":"apple","year":1997,"hall":"apple","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/macos8.jpg","skin":{"chrome":"platinum","bar":"top","menu":"apple","accent":"#3b6ea5","font":"Charcoal,Geneva,'Microsoft YaHei',sans-serif"},"note":"Platinum 铂金主题，灰色立体控件取代黑白线条。乔布斯回归那年，苹果的脸换了一次皮。"},{"id":"macos9","name":"Mac OS","version":"9.2","vendor":"Apple","vendorId":"apple","year":1999,"hall":"apple","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/macos9.jpg","skin":{"chrome":"platinum","bar":"top","menu":"apple","accent":"#3b6ea5","font":"Charcoal,Geneva,'Microsoft YaHei',sans-serif"},"note":"经典 Mac OS 的终点。Sherlock、多用户、语音，还有那只永远找不到的炸弹图标。"},{"id":"osx100","name":"Mac OS X","version":"10.0 Cheetah","vendor":"Apple","vendorId":"apple","year":2001,"hall":"apple","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/osx100.jpg","skin":{"chrome":"aqua","bar":"top","menu":"apple","accent":"#4a90e2","font":"'Lucida Grande','Microsoft YaHei',sans-serif"},"note":"水波纹、糖果按钮、Dock、阴影。Aqua 当年是全世界最漂亮的界面，也被抄得最多。"},{"id":"osx104","name":"Mac OS X","version":"10.4 Tiger","vendor":"Apple","vendorId":"apple","year":2005,"hall":"apple","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/osx104.jpg","skin":{"chrome":"aqua","bar":"top","menu":"apple","accent":"#4a90e2","font":"'Lucida Grande','Microsoft YaHei',sans-serif","dock":true},"note":"Spotlight、Dashboard、Core Image。苹果第一次把搜索变成系统级能力，Dock 也彻底定型。"},{"id":"osx109","name":"OS X","version":"10.9 Mavericks","vendor":"Apple","vendorId":"apple","year":2013,"hall":"apple","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/osx109.jpg","skin":{"chrome":"aqua-flat","bar":"top","menu":"apple","accent":"#2f8fd8","font":"-apple-system,'PingFang SC',sans-serif","dock":true},"note":"放弃猫科命名，转向加州地名。拟物开始退场，扁平与毛玻璃接手。"},{"id":"bigsur","name":"macOS","version":"11 Big Sur","vendor":"Apple","vendorId":"apple","year":2020,"hall":"apple","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/bigsur.jpg","skin":{"chrome":"macos","bar":"top","menu":"apple","accent":"#0a84ff","font":"-apple-system,'PingFang SC',sans-serif","dock":true},"note":"第一次为 Apple Silicon 重画整个界面：圆角、半透明、控制中心，图标全部重绘成统一圆角方。"},{"id":"macos","name":"macOS","version":"Sonoma","vendor":"Apple","vendorId":"apple","year":2023,"hall":"apple","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/macos.jpg","skin":{"chrome":"macos","bar":"top","menu":"apple","accent":"#0a84ff","font":"-apple-system,'SF Pro','PingFang SC',sans-serif","dock":true},"note":"圆角、半透明侧边栏、控制中心、桌面小组件。Unix 内核套上一层最舒服的壳。"},{"id":"iphoneos1","name":"iPhone OS","version":"1.0","vendor":"Apple","vendorId":"apple","year":2007,"hall":"apple","shell":"phone","screenType":"phone","wallpaper":"assets/wallpapers/iphoneos1.jpg","skin":{"chrome":"ios1","bar":"phone","menu":"ios","accent":"#1f6fb2","font":"'Helvetica','PingFang SC',sans-serif"},"note":"拟物化、玻璃按钮、没有复制粘贴也没有 App Store。手机第一次变成一块全是屏幕的东西。"},{"id":"iphoneos3","name":"iPhone OS","version":"3.0","vendor":"Apple","vendorId":"apple","year":2009,"hall":"apple","shell":"phone","screenType":"phone","wallpaper":"assets/wallpapers/iphoneos3.jpg","skin":{"chrome":"ios3","bar":"phone","menu":"ios","accent":"#1f6fb2","font":"'Helvetica','PingFang SC',sans-serif"},"note":"复制粘贴、Spotlight 搜索、彩信、横向键盘。iPhone 补上第一批本该有的功能。"},{"id":"ios6","name":"iOS","version":"6","vendor":"Apple","vendorId":"apple","year":2012,"hall":"apple","shell":"phone","screenType":"phone","wallpaper":"assets/wallpapers/ios6.jpg","skin":{"chrome":"ios6","bar":"phone","menu":"ios","accent":"#007aff","font":"'Helvetica Neue','PingFang SC',sans-serif"},"note":"拟物化的最后一代。皮革、亚麻布、高光玻璃，之后就被一把扫干净了。"},{"id":"ios7","name":"iOS","version":"7","vendor":"Apple","vendorId":"apple","year":2013,"hall":"apple","shell":"phone","screenType":"phone","wallpaper":"assets/wallpapers/ios7.jpg","skin":{"chrome":"ios7","bar":"phone","menu":"ios","accent":"#007aff","font":"-apple-system,'PingFang SC',sans-serif"},"note":"扁平化革命，毛玻璃、细字重、控制中心。Ive 把十年拟物一次性推平，全世界手机跟着变平。"},{"id":"ios17","name":"iOS","version":"17","vendor":"Apple","vendorId":"apple","year":2023,"hall":"apple","shell":"phone","screenType":"phone","wallpaper":"assets/wallpapers/ios17.jpg","skin":{"chrome":"ios17","bar":"phone","menu":"ios","accent":"#0a84ff","font":"-apple-system,'PingFang SC',sans-serif","dynamicIsland":true},"note":"灵动岛、待机显示、可交互小组件。iOS 18 之后开始往个性化上堆料。"}]