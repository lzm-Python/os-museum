[{"id":"kde1","name":"KDE","version":"1.0","vendor":"KDE","vendorId":"kde","year":1998,"hall":"linux","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/kde1.jpg","skin":{"chrome":"kde","bar":"bottom","menu":"kde","accent":"#3b6ea5","font":"'Noto Sans SC',sans-serif"},"note":"第一个做出完整桌面体验的开源项目，任务栏、开始菜单、文件管理器全套照搬 Windows 95。"},{"id":"kde3","name":"KDE","version":"3.5","vendor":"KDE","vendorId":"kde","year":2006,"hall":"linux","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/kde3.jpg","skin":{"chrome":"kde","bar":"bottom","menu":"kde","accent":"#1f6fb2","font":"'Noto Sans SC',sans-serif"},"note":"KDE 3 是一个时代的审美：蓝色塑料感、Kicker 面板、Konqueror。很多人至今认为它最好用。"},{"id":"plasma6","name":"KDE Plasma","version":"6","vendor":"KDE","vendorId":"kde","year":2024,"hall":"linux","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/plasma6.jpg","skin":{"chrome":"kde","bar":"bottom","menu":"kde","accent":"#3daee9","font":"'Noto Sans SC',sans-serif","dock":true},"note":"Wayland 原生、可变刷新率、全局主题。桌面 Linux 的可定制天花板，几乎什么都能改。"},{"id":"ubuntu410","name":"Ubuntu","version":"4.10 Warty","vendor":"Canonical","vendorId":"ubuntu","year":2004,"hall":"linux","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/ubuntu410.jpg","skin":{"chrome":"gnome","bar":"top","menu":"classic","accent":"#772953","font":"'Ubuntu Sans','Noto Sans SC',sans-serif"},"note":"第一版 Ubuntu，棕色猴子壁纸。它的口号是 Linux for human beings，把 Linux 第一次做成人能用的样子。"},{"id":"ubuntu1010","name":"Ubuntu","version":"10.10 Unity","vendor":"Canonical","vendorId":"ubuntu","year":2010,"hall":"linux","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/ubuntu1010.jpg","skin":{"chrome":"unity","bar":"top","menu":"unity","accent":"#5e2750","font":"'Ubuntu Sans','Noto Sans SC',sans-serif","dock":true},"note":"Unity 上线，左侧竖条、全局菜单、HUD。Ubuntu 想统一上网本和桌面，结果争议最大。"},{"id":"ubuntu","name":"Ubuntu","version":"24.04 LTS","vendor":"Canonical","vendorId":"ubuntu","year":2024,"hall":"linux","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/ubuntu.jpg","skin":{"chrome":"gnome","bar":"top","menu":"launcher","accent":"#e95420","font":"'Ubuntu Sans','Noto Sans SC',sans-serif","dock":true},"note":"橙色、每年两版、LTS 五年支持。全世界程序员的第一台 Linux 大多是它。"},{"id":"debian","name":"Debian","version":"12 Bookworm","vendor":"Debian","vendorId":"debian","year":2023,"hall":"linux","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/debian.jpg","skin":{"chrome":"gnome","bar":"top","menu":"launcher","accent":"#d70a53","font":"'Noto Sans SC',sans-serif"},"note":"社区驱动、不商业、只认稳定。Ubuntu 和无数发行版都是它的下游，Linux 世界的宪法。"},{"id":"arch","name":"Arch Linux","version":"rolling","vendor":"Arch","vendorId":"arch","year":2024,"hall":"linux","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/arch.jpg","skin":{"chrome":"tiled","bar":"none","menu":"none","accent":"#1793d1","font":"'Source Code Pro',monospace","primaryWindow":"tiled-shell"},"note":"滚动更新、自己装、没有图形安装器。Arch 用户不用解释，他会主动告诉你他用 Arch。"},{"id":"kali","name":"Kali Linux","version":"2024.1","vendor":"Offensive Security","vendorId":"kali","year":2024,"hall":"linux","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/kali.jpg","skin":{"chrome":"gnome-dark","bar":"top","menu":"launcher","accent":"#00b8d4","font":"'Noto Sans SC',sans-serif","dock":true,"dark":true},"note":"蓝龙、自带三百多个安全工具、默认黑底。它不是给日常用的，是给渗透测试用的。"},{"id":"redhat","name":"Red Hat Linux","version":"9","vendor":"Red Hat","vendorId":"redhat","year":2003,"hall":"linux","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/redhat.jpg","skin":{"chrome":"gnome","bar":"bottom","menu":"classic","accent":"#cc0000","font":"'Noto Sans SC',sans-serif"},"note":"企业 Linux 的原点，红帽帽檐。它证明了开源也能卖订阅，撑起了整个 Linux 商业化的模板。"},{"id":"fedora","name":"Fedora","version":"39","vendor":"Fedora","vendorId":"fedora","year":2023,"hall":"linux","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/fedora.jpg","skin":{"chrome":"gnome","bar":"top","menu":"launcher","accent":"#3c6eb4","font":"'Noto Sans SC',sans-serif"},"note":"红帽的试验田，新东西总是它先用：Wayland、PipeWire、SELinux。稳定版的下游才叫 RHEL。"},{"id":"mint","name":"Linux Mint","version":"21","vendor":"Linux Mint","vendorId":"mint","year":2022,"hall":"linux","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/mint.jpg","skin":{"chrome":"mint","bar":"bottom","menu":"classic","accent":"#87c33d","font":"'Noto Sans SC',sans-serif"},"note":"专门为逃离 Windows 的人做的：绿色、开始菜单、任务栏、Cinnamon。从 XP 迁过来几乎零学习成本。"},{"id":"steamdeck","name":"SteamOS","version":"3.5","vendor":"Valve","vendorId":"valve","year":2023,"hall":"linux","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/steamdeck.jpg","skin":{"chrome":"steam","bar":"bottom","menu":"launcher","accent":"#1a9fff","font":"'Motif Sans','Noto Sans SC',sans-serif","dark":true},"note":"把 Linux 塞进掌机，用 Proton 跑 Windows 游戏。它可能是让 Linux 桌面份额真正动起来的唯一变量。"}]