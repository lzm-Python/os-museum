[{"id":"alto","name":"Xerox Alto","version":"Star","vendor":"Xerox PARC","vendorId":"xerox","year":1973,"hall":"vintage","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/alto.jpg","skin":{"chrome":"alto","bar":"none","menu":"none","accent":"#c8c8c8","font":"'Helvetica',sans-serif","primaryWindow":"alto-star"},"note":"GUI 的原点。鼠标、窗口、图标、位图显示、以太网全在这台机器上第一次凑齐，乔布斯看完才做出了 Mac。"},{"id":"cpm","name":"CP/M","version":"2.2","vendor":"Digital Research","vendorId":"digitalresearch","year":1979,"hall":"vintage","shell":"monitor","screenType":"terminal","wallpaper":"assets/wallpapers/cpm.jpg","skin":{"chrome":"terminal","bar":"none","menu":"none","accent":"#33ff66","font":"'Consolas',monospace"},"term":{"prompt":"A>","intro":["CP/M VERSION 2.2","SERIAL NUMBER 000000","62K TPA",""]},"note":"8080/Z80 上的第一个商用操作系统，A> 提示符。IBM 当年先找的是它，谈崩了才去找微软，历史就此改写。"},{"id":"amiga","name":"AmigaOS","version":"1.3","vendor":"Commodore","vendorId":"commodore","year":1988,"hall":"vintage","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/amiga.jpg","skin":{"chrome":"amiga","bar":"top","menu":"amiga","accent":"#ff8a00","font":"'Topaz',sans-serif"},"note":"4096 色、四个声道、抢占式多任务，1985 年就把 PC 按在地上打。Workbench 的橙蓝配色独一份。"},{"id":"riscos","name":"RISC OS","version":"3","vendor":"Acorn","vendorId":"acorn","year":1991,"hall":"vintage","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/riscos.jpg","skin":{"chrome":"riscos","bar":"bottom","menu":"riscos","accent":"#6b8e23","font":"'Homerton',sans-serif"},"note":"ARM 处理器的出生地。底部图标条、三键鼠标、右键才是主菜单，交互逻辑和全世界都不一样。"},{"id":"os2v12","name":"OS/2","version":"1.2","vendor":"IBM","vendorId":"ibm","year":1988,"hall":"vintage","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/os2v12.jpg","skin":{"chrome":"wps","bar":"bottom","menu":"classic","accent":"#0b4f8a","font":"'Helvetica','Warp Sans',sans-serif"},"note":"Presentation Manager 第一次出现，OS/2 有了图形界面。它和 Windows 本是同根，之后彻底分道。"},{"id":"os2","name":"OS/2 Warp","version":"4","vendor":"IBM","vendorId":"ibm","year":1996,"hall":"vintage","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/os2.jpg","skin":{"chrome":"wps","bar":"bottom","menu":"classic","accent":"#0b4f8a","font":"'Helvetica','Warp Sans',sans-serif"},"note":"对象化桌面 Workplace Shell，拖放、属性页、模板，比同期 Windows 超前一代，可惜被 IBM 自己放弃。"},{"id":"nextstep","name":"NeXTSTEP","version":"3.3","vendor":"NeXT","vendorId":"next","year":1994,"hall":"vintage","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/nextstep.jpg","skin":{"chrome":"next","bar":"leftdock","menu":"vertical","accent":"#8c8c8c","font":"'Helvetica Neue',Helvetica,sans-serif","dark":true},"note":"黑底、竖排菜单、Dock、Display PostScript。苹果后来买下 NeXT，macOS 的骨架就是这台机器。"},{"id":"openstep","name":"OPENSTEP","version":"4.2","vendor":"NeXT","vendorId":"next","year":1997,"hall":"vintage","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/openstep.jpg","skin":{"chrome":"next","bar":"leftdock","menu":"vertical","accent":"#a0a0a0","font":"'Helvetica Neue',Helvetica,sans-serif","dark":true},"note":"NeXT 被苹果收购前最后一版，Objective-C 与 Foundation 框架在这里定型，后来成了 Cocoa。"},{"id":"beos","name":"BeOS","version":"5","vendor":"Be Inc.","vendorId":"be","year":2000,"hall":"vintage","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/beos.jpg","skin":{"chrome":"beos","bar":"top","menu":"none","accent":"#ffd000","font":"'Swis721','Helvetica',sans-serif"},"note":"黄色标签页窗口、能拖到桌面继续跑的复制件、多媒体性能吊打同代。输了市场，赢了所有极客的心。"},{"id":"haiku","name":"Haiku","version":"R1","vendor":"Haiku Inc.","vendorId":"haiku","year":2018,"hall":"vintage","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/haiku.jpg","skin":{"chrome":"beos","bar":"top","menu":"none","accent":"#f5b800","font":"'Swis721','Helvetica',sans-serif"},"note":"BeOS 的开源续命版，保留了黄标签和响应速度。启动十秒进桌面，至今仍有人在用。"},{"id":"irix","name":"IRIX","version":"6.5","vendor":"SGI","vendorId":"sgi","year":1998,"hall":"vintage","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/irix.jpg","skin":{"chrome":"irix","bar":"bottom","menu":"irix","accent":"#3f5f8f","font":"'Helvetica',sans-serif"},"note":"好莱坞特效工作站的系统，Indigo Magic 桌面、4Dwm、能跑 Maya。侏罗纪公园就是在这上面渲染的。"},{"id":"solaris","name":"Solaris","version":"8","vendor":"Sun","vendorId":"sun","year":2000,"hall":"vintage","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/solaris.jpg","skin":{"chrome":"cde","bar":"bottom","menu":"cde","accent":"#4a6f9f","font":"'Helvetica',sans-serif"},"note":"Sun 工作站的标配，CDE 桌面、dtterm、NFS。互联网泡沫年代机房里的蓝色巨人。"},{"id":"qnx","name":"QNX","version":"4 Photon","vendor":"QNX Software","vendorId":"qnx","year":1998,"hall":"vintage","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/qnx.jpg","skin":{"chrome":"photon","bar":"bottom","menu":"photon","accent":"#0f6e8c","font":"'Helvetica',sans-serif"},"note":"整台带 GUI 和浏览器的系统塞进一张 1.44MB 软盘，当年的神话。现在跑在全世界几亿辆车的仪表盘里。"},{"id":"minix","name":"MINIX","version":"3.3","vendor":"VU Amsterdam","vendorId":"minix","year":2014,"hall":"vintage","shell":"monitor","screenType":"terminal","wallpaper":"assets/wallpapers/minix.jpg","skin":{"chrome":"terminal","bar":"none","menu":"none","accent":"#f0f0f0","font":"'Consolas',monospace","ttyCount":8},"term":{"prompt":"root@minix:~#","intro":["MINIX 3.3.0 (VU Amsterdam)","Login as root",""],"tty":true},"note":"谭宁邦写给学生的教材系统，微内核、八个虚拟控制台。Linus 在上面写出了 Linux，然后两人吵了三十年。"},{"id":"plan9","name":"Plan 9","version":"4th Edition","vendor":"Bell Labs","vendorId":"bell","year":2002,"hall":"vintage","shell":"monitor","screenType":"desktop","wallpaper":"assets/wallpapers/plan9.jpg","skin":{"chrome":"rio","bar":"none","menu":"rio","accent":"#5b8db8","font":"'Lucida Sans Typewriter',monospace"},"note":"一切皆文件做到极致，没有桌面没有图标，窗口靠三键鼠标和弦摆放，整个集群共用一套命名空间。"}]